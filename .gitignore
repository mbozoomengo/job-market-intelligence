# ---------------------------------------------------------------------------
# Power BI Project (PBIP) — ne versionner que les définitions texte (TMDL / PBIR)
# ---------------------------------------------------------------------------

# Caches et réglages locaux générés par Power BI Desktop
**/.pbi/localSettings.json
**/.pbi/cache.abf
**/.pbi/editorSettings.json
**/.pbi/unappliedChanges.json

# Fichiers binaires .pbix : volumineux, non diffables, et ils embarquent les données.
# Le projet source est le dossier .pbip (SemanticModel + Report).
*.pbix
*.pbit

# Copies de travail créées par « Enregistrer sous » dans Desktop
*_pbip.*
*_pbip/
*_pbix.*

# ---------------------------------------------------------------------------
# Données
# ---------------------------------------------------------------------------
# Extraction brute d'annonces publiques (contient des contacts de recruteurs) :
# non republiée. Voir README > « Guide de reproduction ».
data_job_offer*.csv
data/*.csv
!ref/*.csv

# ---------------------------------------------------------------------------
# Fichiers temporaires et de sauvegarde
# ---------------------------------------------------------------------------
_backup/
~$*
*.tmp
*.bak
*.log
Thumbs.db
.DS_Store
desktop.ini

# Sorties de validation du générateur de rapport
_build/validate.json

# Node / Python
node_modules/
__pycache__/
*.pyc
.venv/

# Éditeurs
.vscode/
.idea/
.claude/
